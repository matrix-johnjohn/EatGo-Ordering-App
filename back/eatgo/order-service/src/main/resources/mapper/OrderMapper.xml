<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.eatgo.order.mapper.OrderMapper">
    <!-- 更新订单 -->
    <update id="setOrderStatus">
        update dish_order
        <set>
            <if test="status != null">
                status=#{status}
            </if>
            <where>
                <if test="orderId != null">
                    id=#{orderId}
                </if>
            </where>

        </set>
    </update>
    <!--订单列表-->
    <select id="OrderList" resultType="org.eatgo.common.domain.vo.OrderVo">
        select * from dish_order
        <where>
            <if test="userId != null">
                user_id=#{userId}
            </if>
            <if test="status != -1">
                and status=#{status}
            </if>
        </where>
    </select>
</mapper>